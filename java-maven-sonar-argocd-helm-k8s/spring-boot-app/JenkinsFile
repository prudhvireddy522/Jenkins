pipeline {
    agent any

    environment {
        SONAR_URL = "http://localhost:9000"
        IMAGE_NAME = "yourdockerhubusername/ultimate-cicd"
        GIT_USER_NAME = "prudhvireddy522"
        GIT_REPO_NAME = "Jenkins"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/prudhvireddy522/Jenkins.git',
                credentialsId: 'github-creds'
            }
        }

        stage('Build and Test') {
            steps {
                dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_TOKEN')]) {
                    dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
                        sh """
                        mvn sonar:sonar \
                        -Dsonar.host.url=${SONAR_URL} \
                        -Dsonar.login=${SONAR_TOKEN}
                        """
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
                    sh 'docker build -t $IMAGE_NAME:$BUILD_NUMBER .'
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                withDockerRegistry([credentialsId: 'dockerhub-creds']) {
                    sh 'docker push $IMAGE_NAME:$BUILD_NUMBER'
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                withCredentials([string(credentialsId: 'github-creds', variable: 'GITHUB_TOKEN')]) {
                    sh """
                        git config user.email "prudhvireddy522@gmail.com"
                        git config user.name "${GIT_USER_NAME}"

                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
                        java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

                        git add .
                        git commit -m "Update image to ${BUILD_NUMBER}" || echo "No changes"
                        git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
                    """
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finished."
        }
    }
}
