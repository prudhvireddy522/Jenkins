pipeline {
    agent {
        docker {
            image 'maven:3.9.2-openjdk-17'   // Maven + JDK preinstalled
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'  // Docker access
        }
    }

    environment {
        SONAR_URL = "http://host.docker.internal:9000"   // WSL host SonarQube
        GIT_USER_NAME = "prudhvireddy522"
        GIT_REPO_NAME = "Jenkins"
    }

    stages {

        stage('Checkout') {
            steps {
                // Checkout code from GitHub using HTTPS + token
                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        git config --global user.email "prudhvireddy522@gmail.com"
                        git config --global user.name "${GIT_USER_NAME}"
                        git clone https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git
                        cd ${GIT_REPO_NAME}
                        git checkout main
                    '''
                }
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    cd ${GIT_REPO_NAME}/java-maven-sonar-argocd-helm-k8s/spring-boot-app
                    mvn clean package
                '''
            }
        }

        stage('Static Code Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
                    sh '''
                        cd ${GIT_REPO_NAME}/java-maven-sonar-argocd-helm-k8s/spring-boot-app
                        mvn sonar:sonar -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}
                    '''
                }
            }
        }

        stage('Build Docker Image Locally') {
            steps {
                script {
                    def IMAGE_NAME = "springboot-app:${BUILD_NUMBER}"
                    sh """
                        cd ${GIT_REPO_NAME}/java-maven-sonar-argocd-helm-k8s/spring-boot-app
                        docker build -t ${IMAGE_NAME} .
                    """
                }
            }
        }

        stage('Run Docker Container Locally') {
            steps {
                script {
                    def IMAGE_NAME = "springboot-app:${BUILD_NUMBER}"
                    sh """
                        docker rm -f springboot-app || true
                        docker run -d --name springboot-app -p 8080:8080 ${IMAGE_NAME}
                    """
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        cd ${GIT_REPO_NAME}
                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                        git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                        git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                        git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                    '''
                }
            }
        }

    }

    post {
        always {
            echo 'Pipeline finished.'
        }
    }
}
